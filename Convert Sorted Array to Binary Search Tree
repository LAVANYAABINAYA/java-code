class Solution {
    public TreeNode sortedArrayToBST(int[] nums) {
        // Handle the initial call for the entire array range
        return buildBST(nums, 0, nums.length - 1);
    }

    private TreeNode buildBST(int[] nums, int left, int right) {
        // Base case: if the range is invalid, return null
        if (left > right) {
            return null;
        }

        // 1. Find the middle element to ensure the tree remains balanced
        int mid = left + (right - left) / 2;
        
        // 2. Create the current root node
        TreeNode root = new TreeNode(nums[mid]);

        // 3. Recursively build the left and right subtrees
        root.left = buildBST(nums, left, mid - 1);
        root.right = buildBST(nums, mid + 1, right);

        return root;
    }
}
