class Solution {
    public List<Integer> preorderTraversal(TreeNode root) {
        List<Integer> res = new ArrayList<>();
        helper(root, res);
        return res;
    }

    private void helper(TreeNode root, List<Integer> res) {
        if (root == null) return;
        
        res.add(root.val);          // 1. Visit Root
        helper(root.left, res);     // 2. Traverse Left
        helper(root.right, res);    // 3. Traverse Right
    }
}
