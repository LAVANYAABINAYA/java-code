class Solution {
public:
    void merge(vector<int>& nums1, int m, vector<int>& nums2, int n) {
        int len=m+n;
        int k=0;
        int temp=0;
        
        for(int i=m;i<len;i++){
            nums1[i]=nums2[k++];
        }
        for(int j=0;j<len;j++)
        {
            for(int l=j+1;l<len;l++)
            {
                if(nums1[j]>nums1[l])
                {
                    temp=nums1[j];
                    nums1[j]=nums1[l];
                    nums1[l]=temp;
                }

            }
        }
    }
};
