import java.util.ArrayList;
import java.util.List;

class Solution {
    public List<List<Integer>> combine(int n, int k) {
        List<List<Integer>> result = new ArrayList<>();
        backtrack(result, new ArrayList<>(), 1, n, k);
        return result;
    }

    private void backtrack(List<List<Integer>> result, List<Integer> tempList, int start, int n, int k) {
        // Base case: if the combination has k elements, add it to the result
        if (tempList.size() == k) {
            result.add(new ArrayList<>(tempList));
            return;
        }

        // Standard backtracking loop
        for (int i = start; i <= n; i++) {
            // 1. Choose the number
            tempList.add(i);
            
            // 2. Explore: move to i + 1 so we don't reuse the same number
            backtrack(result, tempList, i + 1, n, k);
            
            // 3. Backtrack: remove the number for the next iteration
            tempList.remove(tempList.size() - 1);
        }
    }
}
